rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bookings collection security rules
    match /bookings/{bookingId} {
      // Users can only read their own bookings (prevents IDOR)
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Users can create bookings assigned to their authenticated UID
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.totalAmountPaid is number
        && request.resource.data.totalAmountPaid >= 0;

      // Users can cancel their own booking
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.status == 'CANCELLED';

      // Prevent document deletion
      allow delete: if false;
    }

    // Real-Time Seat Inventory collection
    match /seatInventory/{inventoryId} {
      // Any authenticated user can read occupied seats
      allow read: if request.auth != null;

      // Authenticated users can reserve seats or release seats on cancellation
      allow write: if request.auth != null;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
