rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Bookings collection security rules
    match /bookings/{bookingId} {
      // Users can only read their own bookings (prevents IDOR)
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Users can only create bookings assigned to their authenticated UID
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.totalAmountPaid is number
        && request.resource.data.totalAmountPaid >= 0;

      // Prevent client tampering or deletion of confirmed bookings
      allow update, delete: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
